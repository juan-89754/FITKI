<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Variante nocturna de values-v31. Hace falta su propio archivo porque el
      calificador night tiene mas precedencia que v31: sin esto, en oscuro sobre
      Android 12+ ganaria values-v31 y se usaria el splash de tema claro.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/fitki_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
